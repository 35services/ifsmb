---
layout: null
permalink: /network/graph.json
---
{%- comment -%}
  The network as one file: one node per resource with its raw link fields (part_of, related, team, partners,
  owner_*, event_tag/tags, linked …). assets/js/netzwerk.js loads it and derives the edges (same rules as
  _includes/verbindungen.html); other sites can read it too (federation). Node ids are site-relative URLs –
  resolve them against "site". Todos are not part of the network (they stay local and are too abstract).
{%- endcomment -%}
{
"format": "ifsmb-network",
"version": 1,
"site": {{ site.url | append: site.baseurl | jsonify }},
"title": {{ site.title | jsonify }},
"generated": {{ site.time | date_to_xmlschema | jsonify }},
{%- comment -%}Separator before every node except the first, so any collection may be empty.{%- endcomment -%}
{%- assign sep = "" -%}
"nodes": [
{%- for x in site.projects -%}
{{ sep }}{"id":{{ x.url | relative_url | jsonify }},"type":"projekt","title":{{ x.title | jsonify }},"slug":{{ x.slug | jsonify }},"status":{{ x.status | jsonify }},"personal":{{ x.personal | default: false | jsonify }},"date":{{ x.start | date: "%Y-%m-%d" | jsonify }},"event_tag":{{ x.event_tag | jsonify }},"part_of":{{ x.part_of | jsonify }},"related":{{ x.related | jsonify }},"team":{{ x.team | jsonify }},"partners":{{ x.partners | jsonify }},"tags":{{ x.tags | jsonify }},"linked":{{ x.linked | jsonify }}}{%- assign sep = "," -%}
{%- endfor -%}
{%- for x in site.events -%}
{{ sep }}{"id":{{ x.url | relative_url | jsonify }},"type":"termin","title":{{ x.title | jsonify }},"slug":{{ x.slug | jsonify }},"personal":{{ x.personal | default: false | jsonify }},"date":{{ x.start | date: "%Y-%m-%d" | jsonify }},"projects":{{ x.projects | jsonify }},"team":{{ x.team | jsonify }},"partners":{{ x.partners | jsonify }},"tags":{{ x.tags | jsonify }},"linked":{{ x.linked | jsonify }}}{%- assign sep = "," -%}
{%- endfor -%}
{%- for x in site.posts -%}
{{ sep }}{"id":{{ x.url | relative_url | jsonify }},"type":"beitrag","title":{{ x.title | jsonify }},"personal":{{ x.personal | default: false | jsonify }},"date":{{ x.date | date: "%Y-%m-%d" | jsonify }},"author":{{ x.author | jsonify }},"tags":{{ x.tags | jsonify }},"linked":{{ x.linked | jsonify }}}{%- assign sep = "," -%}
{%- endfor -%}
{%- for x in site.team -%}
{{ sep }}{"id":{{ x.url | relative_url | jsonify }},"type":"person","title":{{ x.title | jsonify }},"slug":{{ x.slug | jsonify }},"linked":{{ x.linked | jsonify }}}{%- assign sep = "," -%}
{%- endfor -%}
{%- for x in site.equipment -%}
{{ sep }}{"id":{{ x.url | relative_url | jsonify }},"type":"ausstattung","title":{{ x.title | jsonify }},"owner_partner":{{ x.owner_partner | jsonify }},"location_partner":{{ x.location_partner | jsonify }},"owner_team":{{ x.owner_team | jsonify }},"owner_name":{{ x.owner_name | jsonify }},"location":{{ x.location | jsonify }},"status":{{ x.status | jsonify }},"tags":{{ x.tags | jsonify }},"linked":{{ x.linked | jsonify }}}{%- assign sep = "," -%}
{%- endfor -%}
{%- for x in site.challenges -%}
{{ sep }}{"id":{{ x.url | relative_url | jsonify }},"type":"herausforderung","title":{{ x.title | jsonify }},"status":{{ x.status | jsonify }},"personal":{{ x.personal | default: false | jsonify }},"date":{{ x.since | date: "%Y-%m-%d" | jsonify }},"projects":{{ x.projects | jsonify }},"team":{{ x.team | jsonify }},"tags":{{ x.tags | jsonify }},"linked":{{ x.linked | jsonify }}}{%- assign sep = "," -%}
{%- endfor -%}
{%- for x in site.press -%}
{{ sep }}{"id":{{ x.url | relative_url | jsonify }},"type":"presse","title":{{ x.title | jsonify }},"date":{{ x.date | date: "%Y-%m-%d" | jsonify }},"tags":{{ x.tags | jsonify }},"linked":{{ x.linked | jsonify }}}{%- assign sep = "," -%}
{%- endfor -%}
{%- for pt in site.data.partners -%}
{{ sep }}{"id":{% if pt.page %}{{ pt.page | relative_url | jsonify }}{% else %}{{ "partner:" | append: pt.name | jsonify }}{% endif %},"type":"partner","title":{{ pt.name | jsonify }},"url":{% if pt.page %}{{ pt.page | relative_url | jsonify }}{% else %}{{ pt.url | jsonify }}{% endif %},"extern":{% if pt.page %}false{% else %}true{% endif %}}{%- assign sep = "," -%}
{%- endfor -%}
]
}
